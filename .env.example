# Copy this file to `.env` and paste your keys. `.env` is git-ignored.

# Claude: by default the brain uses YOUR CLAUDE SUBSCRIPTION through Claude Code
# (config/brain.yaml -> llm.backend: subscription). Just be logged in: run `claude` once.
# Only needed for llm.backend: api (billed per token):
ANTHROPIC_API_KEY=

# Jev - fast typed classification (module / capability / skill / topic / urgency ...).
# Without it the brain falls back to Claude Haiku, then keyword rules.
JEV_API_KEY=

# ElevenLabs - speech-to-text (Scribe) and Alfred's voice.
# Without it the UI falls back to the browser's own speech recognition / synthesis.
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs library (multilingual voices speak Polish well).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
