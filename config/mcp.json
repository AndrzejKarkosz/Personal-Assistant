{
  "mcpServers": {
    "knowledge-base": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["server/kb_server.py", "--bundle", "wiki"],
      "cwd": "E:/Knowledge-Base",
      "description": "Andrzej's personal library (OKF wiki). Read-only from the brain."
    },
    "google-calendar": {
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": { "GOOGLE_OAUTH_CREDENTIALS": "C:/Users/andrz/.config/google-calendar-mcp/gcp-oauth.keys.json", "NODE_OPTIONS": "--use-system-ca" },
      "description": "Google Calendar. Needs an OAuth client JSON - see README.",
      "drop_fields": ["etag", "kind", "htmlLink", "iCalUID", "sequence", "creator", "created", "updated",
                      "eventType", "reminders", "conferenceData", "guestsCanInviteOthers",
                      "guestsCanSeeOtherGuests", "guestsCanModify", "privateCopy", "locked", "backgroundColor",
                      "foregroundColor", "defaultReminders", "notificationSettings", "conferenceProperties"]
    },
    "strava": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["server/strava_server.py"],
      "cwd": "C:/Users/andrz/PycharmProjects/Personal-Assistant",
      "description": "Strava - your activities (swim, bike, run). Once: uv run python server/strava_server.py --login"
    },
    "nutrition": {
      "enabled": true,
      "type": "http",
      "url": "https://nutrition-mcp.com/mcp",
      "oauth": true,
      "description": "Nutrition MCP (nutrition-mcp.com): meals, macros, weight, body measurements, nutrition goals. The first start opens the browser to log in - use the same account as the claude.ai connector."
    },
    "browser": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "description": "Browser automation for bookings (restaurants, appointments)."
    }
  }
}
